# Rust build output
/target/
**/*.rs.bk
*.tmp

# Local databases created during testing (keep examples/sample.sqlite for demos)
examples/*.sqlite-wal
examples/*.sqlite-shm
*.db-journal

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE / editor
.idea/
*.swp
*.swo
*~
.vscode/
*.code-workspace

# Environment / secrets
.env
.env.*

# Debug symbols
*.pdb

*desktop
!packaging/linux/plusplus.desktop

*.key
*.pub
# egui_kittest writes these beside a snapshot when it differs; only the .png baseline
# belongs in git.
**/tests/snapshots/*.old.png
**/tests/snapshots/*.new.png
**/tests/snapshots/*.diff.png

# Website build and local deployment state
website/node_modules/
website/.next/
website/.vercel/
website/out/
website/coverage/
website/.turbo/
website/.eslintcache
website/*.tsbuildinfo
website/next-env.d.ts
website/npm-debug.log*
website/yarn-debug.log*
website/yarn-error.log*
website/pnpm-debug.log*
website/bun-debug.log*
